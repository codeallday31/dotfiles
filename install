#!/usr/bin/env bash

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

link_path() {
    local source_path="$1"
    local target_path="$2"

    if [ ! -e "$source_path" ]; then
        printf 'Error: source does not exist: %s\n' "$source_path" >&2
        return 1
    fi

    if [ -L "$target_path" ] && [ "$(readlink "$target_path")" = "$source_path" ]; then
        printf 'Already linked %s\n' "$target_path"
        return 0
    fi

    mkdir -p "$(dirname "$target_path")"

    if [ -L "$target_path" ]; then
        rm "$target_path"
    elif [ -e "$target_path" ]; then
        local backup_path="${target_path}.backup.$(date +%Y%m%d%H%M%S)"
        mv "$target_path" "$backup_path"
        printf 'Backed up %s to %s\n' "$target_path" "$backup_path"
    fi

    ln -s "$source_path" "$target_path"
    printf 'Linked %s -> %s\n' "$target_path" "$source_path"
}

LINK_PAIRS=(
    "$DOTFILES/nvim"                    "$HOME/.config/nvim"
    "$DOTFILES/lazygit"                 "$HOME/.config/lazygit"
    "$DOTFILES/starship/starship.toml"  "$HOME/.config/starship.toml"
    "$DOTFILES/tmux/tmux.conf"          "$HOME/.tmux.conf"
    "$DOTFILES/scripts/t"               "$HOME/.local/bin/t"
)

for ((i = 0; i < ${#LINK_PAIRS[@]}; i += 2)); do
    link_path "${LINK_PAIRS[i]}" "${LINK_PAIRS[i + 1]}"
done

printf '\nInstall complete. Restart tmux and open nvim.\n'
